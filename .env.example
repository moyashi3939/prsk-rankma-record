# .env.local にコピーして、値を入れてください（.env.local は Git に入れないこと）
DATABASE_URL=postgresql://ユーザー名:パスワード@localhost:5432/DB名
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# 16文字以上のランダムな文字列（node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
SESSION_SECRET=
# 管理者にするGmail（カンマ区切り）
ADMIN_EMAILS=
